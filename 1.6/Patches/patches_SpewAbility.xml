<?xml version="1.0" encoding="utf-8" ?>
<Patch><!--Spew range factor works on the following abilities-->
	<Operation Class="PatchOperationFindMod">
		<mods>
		  <li>Biotech</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/AbilityDef[defName="AcidSpray" or defName="FoamSpray" or defName="FireSpew"]</xpath>
					<value>
						<li Class="HautsFramework.Hauts_SpewAbility" />
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/AbilityDef[defName="FireSpew"]/comps/li[@Class="CompProperties_AbilityFireSpew"]</xpath>
					<value>
					  <li Class="HautsFramework.CompProperties_AbilityFireSpewScalable">
						<range>7.9</range>
						<lineWidthEnd>3</lineWidthEnd>
						<filthDef>Filth_FlammableBile</filthDef>
						<effecterDef>Fire_Spew</effecterDef>
						<canHitFilledCells>true</canHitFilledCells>
					  </li>
					</value>
				</li>
				<li Class="PatchOperationFindMod">
					<mods>
					  <li>[FSF] Advanced Bionics Expansion</li>
					</mods>
					<match Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationAddModExtension">
								<xpath>/Defs/AbilityDef[defName="FSFAdvBionicAcidJaw" or defName="FSFAdvBionicFlameJaw"]</xpath>
								<value>
									<li Class="HautsFramework.Hauts_SpewAbility" />
								</value>
							</li>
						</operations>
					</match>
				</li>
				<li Class="PatchOperationFindMod">
					<mods>
					  <li>Alpha Genes</li>
					</mods>
					<match Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationAddModExtension">
								<xpath>/Defs/AbilityDef[defName="AG_GreaterAcidicVomit" or defName="AG_GreaterFireSpew" or defName="AG_FreezingBreath" or defName="AG_NoxiousBreath" or defName="AG_SterilizingBreath"]</xpath>
								<value>
									<li Class="HautsFramework.Hauts_SpewAbility" />
								</value>
							</li>
						</operations>
					</match>
				</li>
				<li Class="PatchOperationFindMod">
					<mods>
					  <li>Alpha Implants</li>
					</mods>
					<match Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationAddModExtension">
								<xpath>/Defs/AbilityDef[defName="AI_AnimalAcidSpray" or defName="AI_AnimalFoamSpray" or defName="AI_AnimalFireSpew"]</xpath>
								<value>
									<li Class="HautsFramework.Hauts_SpewAbility" />
								</value>
							</li>
						</operations>
					</match>
				</li>
				<li Class="PatchOperationFindMod">
					<mods>
					  <li>Big and Small - Genes &amp; More</li>
					</mods>
					<match Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationAddModExtension">
								<xpath>/Defs/AbilityDef[defName="BS_FoamSpray" or defName="BS_StickyAcidSpray"]</xpath>
								<value>
									<li Class="HautsFramework.Hauts_SpewAbility" />
								</value>
							</li>
						</operations>
					</match>
				</li>
				<li Class="PatchOperationFindMod">
					<mods>
					  <li>Expanded Biotech Style Abilities</li>
					</mods>
					<match Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationAddModExtension">
								<xpath>/Defs/AbilityDef[defName="EBSA_FireSpray" or defName="EBSA_FoamSpew" or defName="EBSA_AcidSpew" or defName="EBSA_BloodSpew" or defName="EBSA_BloodSpew_Hemogen"]</xpath>
								<value>
									<li Class="HautsFramework.Hauts_SpewAbility" />
								</value>
							</li>
						</operations>
					</match>
				</li>
				<li Class="PatchOperationFindMod">
					<mods>
					  <li>Obsidia Expansion - Axotl Xenotype</li>
					</mods>
					<match Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationAddModExtension">
								<xpath>/Defs/AbilityDef[defName="OE_AxotlSpit_EMP" or defName="OE_AxotlSpit_Fire" or defName="OE_AxotlSpit_Tox"]</xpath>
								<value>
									<li Class="HautsFramework.Hauts_SpewAbility" />
								</value>
							</li>
							<li Class="PatchOperationFindMod">
								<mods>
								  <li>Obsidia Expansion</li>
								</mods>
								<match Class="PatchOperationSequence">
									<operations>
										<li Class="PatchOperationAddModExtension">
											<xpath>/Defs/AbilityDef[defName="OE_AxotlSpit_Acid" or defName="OE_AxotlSpit_Cryo" or defName="OE_AxotlSpit_Blast"]</xpath>
											<value>
												<li Class="HautsFramework.Hauts_SpewAbility" />
											</value>
										</li>
									</operations>
								</match>
							</li>
						</operations>
					</match>
				</li>
				<li Class="PatchOperationFindMod">
					<mods>
					  <li>Obsidia Expansion - Drakonids Xenotype</li>
					</mods>
					<match Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationAddModExtension">
								<xpath>/Defs/AbilityDef[defName="OE_DragonBreath"]</xpath>
								<value>
									<li Class="HautsFramework.Hauts_SpewAbility" />
								</value>
							</li>
							<li Class="PatchOperationReplace">
								<xpath>/Defs/AbilityDef[defName="OE_DragonBreath"]/comps/li[@Class="CompProperties_AbilityFireSpew"]</xpath>
								<value>
								  <li Class="HautsFramework.CompProperties_AbilityFireSpewScalable">
									<range>12.9</range>
									<lineWidthEnd>9</lineWidthEnd>
									<filthDef>Filth_FlammableBile</filthDef>
									<effecterDef>Fire_Spew</effecterDef>
									<canHitFilledCells>true</canHitFilledCells>
								  </li>
								</value>
							</li>
						</operations>
					</match>
				</li>
				<li Class="PatchOperationFindMod">
					<mods>
					  <li>Vanilla Quests Expanded - Ancients</li>
					</mods>
					<match Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationAddModExtension">
								<xpath>/Defs/AbilityDef[defName="VQEA_InfernoSpew"]</xpath>
								<value>
									<li Class="HautsFramework.Hauts_SpewAbility" />
								</value>
							</li>
							<li Class="PatchOperationReplace">
								<xpath>/Defs/AbilityDef[defName="VQEA_InfernoSpew"]/comps/li[@Class="CompProperties_AbilityFireSpew"]</xpath>
								<value>
								  <li Class="HautsFramework.CompProperties_AbilityFireSpewScalable">
									<range>13.9</range>
									<damAmount>12</damAmount>
									<lineWidthEnd>5</lineWidthEnd>
									<filthDef>Filth_FlammableBile</filthDef>
									<effecterDef>Fire_Spew</effecterDef>
									<canHitFilledCells>true</canHitFilledCells>
								  </li>
								</value>
							</li>
						</operations>
					</match>
				</li>
				<li Class="PatchOperationFindMod">
					<mods>
					  <li>Vanilla Races Expanded - Sanguophage</li>
					</mods>
					<match Class="PatchOperationSequence">
						<operations>
							<!--<li Class="PatchOperationAddModExtension">
								<xpath>/Defs/AbilityDef[defName="VRE_ToxicCloud"]</xpath>
								<value>
									<li Class="HautsFramework.Hauts_SpewAbility" />
								</value>
							</li>-->
							<li Class="PatchOperationAddModExtension">
								<xpath>/Defs/AbilityDef[defName="VRE_ViscuousGoo" or defName="VRE_ViscuousGoo_SingleUse"]</xpath>
								<value>
									<li Class="HautsFramework.Hauts_SpewAbility" />
								</value>
							</li>
						</operations>
					</match>
				</li>
			</operations>
		</match>
	</Operation>
	<Operation Class="PatchOperationFindMod">
		<mods>
		  <li>Odyssey</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/AbilityDef[defName="EggSpew"]</xpath>
					<value>
						<li Class="HautsFramework.Hauts_SpewAbility" />
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/AbilityDef[defName="SludgeSpew"]</xpath>
					<value>
						<li Class="HautsFramework.Hauts_SpewAbility" />
					</value>
				</li>
			</operations>
		</match>
	</Operation>
	
	<Operation Class="PatchOperationFindMod">
		<mods>
		  <li>Det's Xenotypes - Boglegs</li>
		</mods>
		<match Class="PatchOperationAddModExtension">
			<xpath>/Defs/AbilityDef[defName="DV_MuckSpit"]</xpath>
			<value>
				<li Class="HautsFramework.Hauts_SpewAbility" />
			</value>
		</match>
	</Operation>
	
	<Operation Class="PatchOperationFindMod">
		<mods>
		  <li>Fray of the Fog</li>
		</mods>
		<match Class="PatchOperationAddModExtension">
			<xpath>/Defs/AbilityDef[defName="dvd_AbilityStunBreath"]</xpath>
			<value>
				<li Class="HautsFramework.Hauts_SpewAbility" />
			</value>
		</match>
	</Operation>
	
	<Operation Class="PatchOperationFindMod">
		<mods>
		  <li>Vanilla Factions Expanded - Insectoids 2</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/AbilityDef[defName="VFEI2_FlameSpew"]/comps/li[@Class="VFEInsectoids.CompProperties_AbilityFireSpew"]</xpath>
					<value>
					  <li Class="HautsFramework.CompProperties_AbilityFireSpewScalable">
						<range>9.9</range>
						<filthChance>0.5</filthChance>
						<lineWidthEnd>3</lineWidthEnd>
						<filthDef>VFEI2_Filth_FlammableBile</filthDef>
						<effecterDef>VFEI2_Fire_Spew</effecterDef>
						<canHitFilledCells>true</canHitFilledCells>
					  </li>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/AbilityDef[defName="VFEI2_LargeAcidSpew"]/comps/li[@Class="VFEInsectoids.CompProperties_AbilityAcidSpew"]</xpath>
					<value>
					  <li Class="HautsFramework_VFEInsectoids2.CompProperties_AbilityAcidSpewScalable">
						<range>16.9</range>
						<lineWidthEnd>3</lineWidthEnd>
						<filthDef>Filth_SpentAcid</filthDef>
						<effecterDef>VFEI2_LargeAcidSpew</effecterDef>
						<canHitFilledCells>true</canHitFilledCells>
						<damAmount>10</damAmount>
					  </li>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/AbilityDef[defName="VFEI2_ChemfuelSpew"]/comps/li[@Class="VFEInsectoids.CompProperties_AbilityFuelSpew"]</xpath>
					<value>
					  <li Class="HautsFramework_VFEInsectoids2.CompProperties_AbilityFuelSpewScalable">
						<range>10.9</range>
						<lineWidthEnd>6</lineWidthEnd>
						<damAmount>1</damAmount>
						<effecterDef>VFEI2_ChemfuelSpew</effecterDef>
						<filthDef>VFEI2_Filth_FlammableBile</filthDef>
						<canHitFilledCells>true</canHitFilledCells>
					  </li>
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/AbilityDef[defName="VFEI2_InsectAcidSpit" or defName="VFEI2_InsectAcidSpew" or defName="VFEI2_LargeAcidSpew" or defName="VFEI2_ChemfuelSpew" or defName="VFEI2_ChemfuelSpit" or defName="VFEI2_FlameSpew"]</xpath>
					<value>
						<li Class="HautsFramework.Hauts_SpewAbility" />
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>