<?xml version="1.0" encoding="UTF-8"?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
		  <li>Vanilla Skills Rexamined</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<!--rebalances-->
				<li Class="PatchOperationAdd">
				  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_Demolisher"]/statOffsets</xpath>
					<value>
					  <MoveSpeed>0.01</MoveSpeed>
					</value>
				</li>
				<li Class="PatchOperationAdd">
				  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_Larceny"]/statOffsets</xpath>
					<value>
					  <HackingSpeed>0.05</HackingSpeed>
					  <HackingStealth>1</HackingStealth>
					</value>
				</li>
				<li Class="PatchOperationAdd">
				  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_Surveyor"]/statOffsets</xpath>
					<value>
					  <CaravanBonusSpeedFactor>0.01</CaravanBonusSpeedFactor>
					  <Hauts_CaravanVisibilityOffset>-0.06</Hauts_CaravanVisibilityOffset>
					</value>
				</li>
				<li Class="PatchOperationAdd">
				  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_Skulduggery"]/statOffsets</xpath>
					<value>
					  <Hauts_MaxPilferingValue>25</Hauts_MaxPilferingValue>
					  <NegotiationAbility>0.025</NegotiationAbility>
					</value>
				</li>
				<!--renames-->
				<li Class="PatchOperationReplace">
				  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_Demolisher"]/label</xpath>
					<value>
					  <label>Demolisher</label>
					</value>
				</li>
				<li Class="PatchOperationReplace">
				  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_Surveyor"]/label</xpath>
					<value>
					  <label>Geographer</label>
					</value>
				</li>
				<li Class="PatchOperationReplace">
				  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_Larceny"]/label</xpath>
					<value>
					  <label>Safecracker</label>
					</value>
				</li>
				<li Class="PatchOperationReplace">
				  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_Skulduggery"]/label</xpath>
					<value>
					  <label>Swindler</label>
					</value>
				</li>
				<!--redescribes-->
				<li Class="PatchOperationReplace">
				  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_Demolisher"]/description</xpath>
					<value>
					  <description>An expertise in quickly and safely taking apart buildings and bases.</description>
					</value>
				</li>
				<li Class="PatchOperationReplace">
				  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_Surveyor"]/description</xpath>
					<value>
					  <description>An expertise in navigating and scanning the terrain.</description>
					</value>
				</li>
				<li Class="PatchOperationReplace">
				  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_Larceny"]/description</xpath>
					<value>
					  <description>An expertise in bypassing security measures and nabbing valuables.\n\n(Pilfering stealth allows you to command this character to pickpocket non-player characters or burglarize non-player settlements on visiting them.)</description>
					</value>
				</li>
				<li Class="PatchOperationReplace">
				  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_Skulduggery"]/description</xpath>
					<value>
					  <description>An expertise in deceiving others, so as to take their valuables without their noticing.\n\n(Pilfering stealth allows you to command this character to pickpocket non-player characters or burglarize non-player settlements on visiting them.)</description>
					</value>
				</li>
				<!--DLC-locked stuff-->
				<li Class="PatchOperationFindMod">
					<mods>
					  <li>Ideology</li>
					</mods>
					<match Class="PatchOperationSequence">
						<operations>
							<!--alternatives to Treespeaker solely focused on dryads; the Plants one also grants (a smaller amount of) pruning speed, the Animals one is substantially more dryad per dryad-->
							<li Class="PatchOperationAdd">
							  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_GauranlenExpert2"]/statOffsets</xpath>
								<value>
								  <PruningSpeed>0.03</PruningSpeed>
								</value>
							</li>
							<li Class="PatchOperationReplace">
							  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_GauranlenExpert2"]/label</xpath>
								<value>
								  <label>Gauranlen Caretaker</label>
								</value>
							</li>
							<li Class="PatchOperationReplace">
							  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_GauranlenExpert2"]/description</xpath>
								<value>
								  <description>An expertise in taking care of gauranlen trees to support their dryad populations.</description>
								</value>
							</li>
							<li Class="PatchOperationReplace">
							  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_GauranlenExpert"]/statOffsets/Hauts_MaxDryadFactor</xpath>
								<value>
								  <Hauts_MaxDryadFactor>0.1</Hauts_MaxDryadFactor>
								</value>
							</li>
							<li Class="PatchOperationReplace">
							  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_GauranlenExpert"]/label</xpath>
								<value>
								  <label>Dryad Handler</label>
								</value>
							</li>
							<li Class="PatchOperationReplace">
							  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_GauranlenExpert"]/description</xpath>
								<value>
								  <description>An expertise in facilitating larger populations of dryads per gauranlen tree.</description>
								</value>
							</li>
						</operations>
					</match>
				</li>
				<li Class="PatchOperationFindMod">
					<mods>
					  <li>Biotech</li>
					</mods>
					<match Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationReplace">
							  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_Teacher"]/statOffsets/Hauts_InstructiveAbility</xpath>
								<value>
								  <Hauts_InstructiveAbility>0.1</Hauts_InstructiveAbility>
								  <GlobalLearningFactor>0.01</GlobalLearningFactor>
								</value>
							</li>
							<li Class="PatchOperationReplace">
							  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_Teacher"]/label</xpath>
								<value>
								  <label>Educator</label>
								</value>
							</li>
							<li Class="PatchOperationReplace">
							  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_Teacher"]/description</xpath>
								<value>
								  <description>An expertise in educating others and, to a lesser extent, oneself.</description>
								</value>
							</li>
						</operations>
					</match>
				</li>
				<!--other mod-locked stuff-->
				<li Class="PatchOperationFindMod">
					<mods>
					  <li>Vanilla Recycling Expanded</li>
					</mods>
					<match Class="PatchOperationSequence">
						<operations><!--Recycling becomes Toxicologist-->
							<li Class="PatchOperationAdd">
							  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_Recycler"]/statOffsets</xpath>
								<value>
								  <Hauts_OverdoseSusceptibility>-0.02</Hauts_OverdoseSusceptibility>
								  <ToxicResistance>0.025</ToxicResistance>
								  <Hauts_ToxicDamageFactor>-0.01</Hauts_ToxicDamageFactor>
								</value>
							</li>
							<li Class="PatchOperationReplace">
							  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_Recycler"]/label</xpath>
								<value>
								  <label>Toxicologist</label>
								</value>
							</li>
							<li Class="PatchOperationReplace">
							  <xpath>Defs/VSE.Expertise.ExpertiseDef[defName="Hauts_Recycler"]/description</xpath>
								<value>
								  <description>An expertise in safely handling and utilizing dangerous chemicals.</description>
								</value>
							</li>
						</operations>
					</match>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>