<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!--unless they're given the BelongsToEventPool DME, incidents are eligible for auto-assignation of a BelongsToEventPool purely based on their letterDef. Makeable is off by default for these-->
	<Operation Class="PatchOperationAddModExtension">
		<xpath>/Defs/LetterDef[@Name="ThreatBig"]</xpath>
		<value>
			<li Class="HautsFramework.AutoAssignEventPool">
				<autoBad>true</autoBad>
				<autoImpact>2</autoImpact>
				<autoMakeable>false</autoMakeable>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationAddModExtension">
		<xpath>/Defs/LetterDef[defName="ThreatSmall"]</xpath>
		<value>
			<li Class="HautsFramework.AutoAssignEventPool">
				<autoBad>true</autoBad>
				<autoImpact>1</autoImpact>
				<autoMakeable>false</autoMakeable>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationAddModExtension">
		<xpath>/Defs/LetterDef[@Name="NegativeEvent"]</xpath>
